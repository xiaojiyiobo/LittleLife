# Store the real file as /mnt/mmcblk0p6/littlelife/secrets/backup.env with mode 0600.
# Repository A is required. Repository B is optional; if used, choose an independent
# provider/account and define both B values. The accepted initial deployment uses
# Google Drive as repository A and leaves B unset.
RESTIC_REPOSITORY_A=rclone:google-drive:littlelife-restic
RESTIC_PASSWORD_FILE_A=/mnt/mmcblk0p6/littlelife/secrets/restic-password-a
# RESTIC_REPOSITORY_B=rclone:provider-b:littlelife-restic
# RESTIC_PASSWORD_FILE_B=/mnt/mmcblk0p6/littlelife/secrets/restic-password-b
RCLONE_CONFIG=/mnt/mmcblk0p6/littlelife/secrets/rclone.conf

